chm_image = "us-east4-docker.pkg.dev/chm-network/chm-apps/chm@sha256:<image-digest>"

alert_email = "danny@oceanagentics.com"

# Enable only after an Explorer image exists and the Cloud SQL cost is approved.
enable_explorer                       = false
explorer_image                        = "us-east4-docker.pkg.dev/chm-network/chm-apps/explorer-public@sha256:<image-digest>"
explorer_admin_image                  = "us-east4-docker.pkg.dev/chm-network/chm-apps/explorer-admin@sha256:<image-digest>"
explorer_admin_iap_backend_service_id = "<explorer-admin-web-backend-id>"
